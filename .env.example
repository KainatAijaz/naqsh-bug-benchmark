# Copy to .env.local and fill in with YOUR NEW benchmark Supabase project (never the live app)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_ANON_KEY
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-REF
# Seeded bugs: none | all | comma list such as B01,B04,B17
VITE_BUGS=none
